; Svelte on top of the HTML queries (registered together): {#if}, {#each}, {@html} and friends.
[
  "as"
  "key"
  "html"
  "snippet"
  "render"
  "const"
  "if"
  "else"
  "else if"
  "then"
  "each"
  "await"
  "catch"
  "debug"
] @keyword

(snippet_name) @function

[
  "{"
  "}"
] @punctuation.bracket

[
  "#"
  ":"
  "/"
  "@"
] @punctuation.delimiter
