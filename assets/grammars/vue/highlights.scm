; Vue on top of the HTML queries (registered together): directives and {{ }} interpolation.
(directive_name) @attribute
(directive_value) @attribute
(directive_modifier) @attribute
(dynamic_directive_inner_value) @variable

[
  "{{"
  "}}"
] @punctuation.special

[
  ":"
  "@"
  "#"
  "."
] @punctuation.delimiter

[
  "["
  "]"
] @punctuation.bracket
